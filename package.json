{
  "name": "mock/mock-data-generator",
  "version": "1.0.4",
  "description": "Generate realistic mock data without external dependencies",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "mock-generate": "./dist/bin/generate.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "clean": "node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true,force:true});console.log('cleaned')\"",
    "prebuild": "npm run clean",
    "test": "jest --coverage",
    "test:run": "jest --coverage --forceExit",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests examples",
    "prepublishOnly": "npm run build && npm run test:run",
    "version": "node scripts/update-changelog.js && git add CHANGELOG.md",
    "postversion": "git push origin master & git push origin --tags",
    "publish:dry": "npm publish --access public --dry-run",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "keywords": [
    "mock",
    "data",
    "generator",
    "testing",
    "faker",
    "fixtures",
    "seed",
    "typescript"
  ],
  "author": "Sahil Khatiwada",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahilkhatiwada/mock-data-generator.git"
  },
  "bugs": {
    "url": "https://github.com/sahilkhatiwada/mock-data-generator/issues"
  },
  "homepage": "https://github.com/sahilkhatiwada/mock-data-generator#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/cli.ts",
      "!src/bin/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "testMatch": [
      "**/tests/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  }
}
